<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VocalCoach Pro - Seu Professor de Canto Inteligente</title>
    <style>
        :root {
            --primary: #6C5CE7;
            --secondary: #A29BFE;
            --accent: #FD79A8;
            --success: #00B894;
            --warning: #FDCB6E;
            --background: #2D3436;
            --surface: #353B48;
            --text: #FFFFFF;
            --text-secondary: #B2BEC3;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .app-container {
            max-width: 1200px;
            width: 100%;
            background: var(--background);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            font-size: 35px;
        }

        .logo h1 {
            font-size: 24px;
            font-weight: bold;
        }

        .logo span {
            color: #FDCB6E;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            padding: 20px;
        }

        .section {
            background: var(--surface);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .voice-detection {
            grid-column: 1 / -1;
            text-align: center;
            padding: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            position: relative;
            overflow: hidden;
        }

        .pitch-indicator {
            width: 100%;
            height: 200px;
            background: var(--surface);
            border-radius: 10px;
            margin: 20px 0;
            position: relative;
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.1);
        }

        .pitch-line {
            position: absolute;
            width: 100%;
            height: 4px;
            background: var(--accent);
            left: 0;
            transition: top 0.05s;
            box-shadow: 0 0 10px var(--accent);
        }

        .target-note {
            position: absolute;
            width: 100%;
            height: 4px;
            background: var(--success);
            left: 0;
            box-shadow: 0 0 10px var(--success);
        }

        .frequency-display {
            font-size: 48px;
            font-weight: bold;
            color: #FDCB6E;
            margin: 10px 0;
        }

        .note-display {
            font-size: 24px;
            color: var(--secondary);
        }

        .song-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .song-item {
            background: var(--background);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .song-item:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .song-item.active {
            border-color: var(--primary);
            background: rgba(108, 92, 231, 0.2);
        }

        .song-artist {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 5px;
        }

        .lyrics-display {
            max-height: 300px;
            overflow-y: auto;
            background: var(--background);
            border-radius: 10px;
            padding: 20px;
            font-size: 18px;
            line-height: 1.8;
        }

        .current-lyric {
            color: #FDCB6E;
            font-weight: bold;
            font-size: 24px;
            animation: pulse 1s infinite;
        }

        .lyric-completed {
            opacity: 0.5;
        }

        .lyric-upcoming {
            opacity: 0.7;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        .controls {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            background: var(--primary);
            color: white;
            min-width: 150px;
        }

        .btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 92, 231, 0.4);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-success {
            background: var(--success);
        }

        .btn-warning {
            background: #e17055;
            color: white;
        }

        .feedback-box {
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            font-size: 16px;
            font-weight: bold;
            display: none;
            animation: slideIn 0.3s;
        }

        .feedback-box.show {
            display: block;
        }

        .feedback-info {
            background: rgba(108, 92, 231, 0.2);
            border: 2px solid var(--primary);
            color: var(--secondary);
        }

        .feedback-success {
            background: rgba(0, 184, 148, 0.2);
            border: 2px solid var(--success);
            color: #55efc4;
        }

        .feedback-warning {
            background: rgba(253, 203, 110, 0.2);
            border: 2px solid var(--warning);
            color: #ffeaa7;
        }

        @keyframes slideIn {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .progress-bar {
            width: 100%;
            height: 10px;
            background: var(--background);
            border-radius: 5px;
            margin: 10px 0;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--success));
            border-radius: 5px;
            transition: width 0.3s;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .stat-card {
            background: var(--background);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .stat-value {
            font-size: 32px;
            font-weight: bold;
            color: #FDCB6E;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 14px;
            color: var(--text-secondary);
        }

        .voice-type-badge {
            display: inline-block;
            padding: 8px 16px;
            background: rgba(108, 92, 231, 0.3);
            border: 2px solid var(--primary);
            border-radius: 20px;
            margin-top: 10px;
            font-weight: bold;
        }

        @media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }
            
            .frequency-display {
                font-size: 36px;
            }
            
            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="header">
            <div class="logo">
                <span class="logo-icon">🎤</span>
                <h1>VocalCoach <span>Pro</span></h1>
            </div>
            <div>
                <span id="connectionStatus">🔴 Microfone Desconectado</span>
            </div>
        </div>

        <div class="main-content">
            <!-- Detector de Voz em Tempo Real -->
            <div class="voice-detection">
                <div class="section-title">
                    <span>🎵</span> Detector de Tom em Tempo Real
                </div>
                <div class="pitch-indicator" id="pitchIndicator">
                    <div class="target-note" id="targetNote" style="top: 50%;"></div>
                    <div class="pitch-line" id="pitchLine" style="top: 50%;"></div>
                </div>
                <div class="frequency-display" id="frequencyDisplay">0 Hz</div>
                <div class="note-display" id="noteDisplay">--</div>
                <div id="voiceTypeDisplay" style="margin-top: 10px;"></div>
                <div id="feedbackBox" class="feedback-box"></div>
                <div class="controls">
                    <button class="btn" id="micButton" onclick="toggleMicrophone()">🎤 Ativar Microfone</button>
                    <button class="btn btn-success" id="startButton" onclick="startPractice()" disabled>▶️ Iniciar Treino</button>
                    <button class="btn btn-warning" onclick="stopPractice()">⏹️ Parar</button>
                </div>
            </div>

            <!-- Lista de Músicas -->
            <div class="section">
                <div class="section-title">
                    <span>🎼</span> Músicas para Treinar
                </div>
                <div class="song-list" id="songList">
                    <!-- Músicas serão adicionadas aqui -->
                </div>
            </div>

            <!-- Letra da Música -->
            <div class="section">
                <div class="section-title">
                    <span>📝</span> Letra da Música
                </div>
                <div class="lyrics-display" id="lyricsDisplay">
                    <p>Selecione uma música para começar</p>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
                </div>
                <div id="songProgress">0% completo</div>
            </div>

            <!-- Estatísticas -->
            <div class="section">
                <div class="section-title">
                    <span>📊</span> Seu Progresso
                </div>
                <div class="stats">
                    <div class="stat-card">
                        <div class="stat-value" id="accuracyStat">0%</div>
                        <div class="stat-label">Precisão</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="notesHitStat">0</div>
                        <div class="stat-label">Notas Atingidas</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="sessionTimeStat">0:00</div>
                        <div class="stat-label">Tempo de Treino</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configuração do aplicativo
        const app = {
            isMicActive: false,
            isPracticing: false,
            audioContext: null,
            analyser: null,
            microphone: null,
            mediaStream: null,
            currentSong: null,
            currentLyricIndex: 0,
            notesHit: 0,
            totalNotes: 0,
            sessionStart: null,
            timerInterval: null,
            voiceType: null,
            targetFrequency: 0,
            currentFrequency: 0,
            tolerance: 50, // tolerância em cents (50 = meio semitom)
            animationFrame: null,
            noteHoldStart: null,
            noteHoldDuration: 0,
            requiredHoldDuration: 500, // 500ms para considerar nota atingida
        };

        // Banco de dados de músicas
        const songs = [
            {
                title: "Halo",
                artist: "Beyoncé",
                difficulty: "Iniciante",
                vocalRange: "G3 - E5",
                lyrics: [
                    { text: "Remember those walls I built", note: "C4", frequency: 261.63 },
                    { text: "Well, baby, they're tumbling down", note: "D4", frequency: 293.66 },
                    { text: "And they didn't even put up a fight", note: "E4", frequency: 329.63 },
                    { text: "They didn't even make a sound", note: "F4", frequency: 349.23 },
                    { text: "I found a way to let you in", note: "G4", frequency: 392.00 },
                    { text: "But I never really had a doubt", note: "A4", frequency: 440.00 },
                    { text: "Standing in the light of your halo", note: "C5", frequency: 523.25 },
                    { text: "I got my angel now", note: "B4", frequency: 493.88 },
                ]
            },
            {
                title: "Levitating",
                artist: "Dua Lipa",
                difficulty: "Intermediário",
                vocalRange: "F3 - D5",
                lyrics: [
                    { text: "If you wanna run away with me", note: "G3", frequency: 196.00 },
                    { text: "I know a galaxy and I can take you", note: "A3", frequency: 220.00 },
                    { text: "For a ride", note: "B3", frequency: 246.94 },
                    { text: "I had a premonition that we fell", note: "C4", frequency: 261.63 },
                    { text: "Into a rhythm where the music don't stop", note: "D4", frequency: 293.66 },
                    { text: "For life", note: "E4", frequency: 329.63 },
                    { text: "Glitter in the sky, glitter in my eyes", note: "F4", frequency: 349.23 },
                    { text: "Shining just the way I like", note: "G4", frequency: 392.00 },
                ]
            },
            {
                title: "Easy On Me",
                artist: "Adele",
                difficulty: "Iniciante",
                vocalRange: "E3 - C5",
                lyrics: [
                    { text: "There ain't no gold in this river", note: "E3", frequency: 164.81 },
                    { text: "That I've been washin' my hands in forever", note: "F3", frequency: 174.61 },
                    { text: "I know there is hope in these waters", note: "G3", frequency: 196.00 },
                    { text: "But I can't bring myself to swim", note: "A3", frequency: 220.00 },
                    { text: "When I am drowning in this silence", note: "C4", frequency: 261.63 },
                    { text: "Baby, let me in", note: "D4", frequency: 293.66 },
                ]
            },
            {
                title: "Shallow",
                artist: "Lady Gaga & Bradley Cooper",
                difficulty: "Intermediário",
                vocalRange: "G3 - E5",
                lyrics: [
                    { text: "Tell me something, girl", note: "G3", frequency: 196.00 },
                    { text: "Are you happy in this modern world?", note: "C4", frequency: 261.63 },
                    { text: "Or do you need more?", note: "D4", frequency: 293.66 },
                    { text: "Is there something else you're searching for?", note: "E4", frequency: 329.63 },
                    { text: "I'm falling", note: "F4", frequency: 349.23 },
                    { text: "In all the good times", note: "G4", frequency: 392.00 },
                    { text: "I find myself longing for change", note: "A4", frequency: 440.00 },
                    { text: "And in the bad times, I fear myself", note: "C5", frequency: 523.25 },
                ]
            }
        ];

        // Inicialização
        function init() {
            displaySongs();
            updateConnectionStatus();
            
            // Adicionar listeners para teclado
            document.addEventListener('keydown', handleKeyboard);
        }

        // Lidar com atalhos de teclado
        function handleKeyboard(event) {
            switch(event.key.toLowerCase()) {
                case 'm':
                    toggleMicrophone();
                    break;
                case ' ':
                    event.preventDefault();
                    if (app.isPracticing) {
                        stopPractice();
                    } else {
                        startPractice();
                    }
                    break;
                case 's':
                    if (app.isPracticing) {
                        stopPractice();
                    }
                    break;
            }
        }

        // Exibir músicas na lista
        function displaySongs() {
            const songList = document.getElementById('songList');
            songList.innerHTML = '';
            
            songs.forEach((song, index) => {
                const songElement = document.createElement('div');
                songElement.className = 'song-item';
                songElement.innerHTML = `
                    <div>
                        <strong>${song.title}</strong>
                        <div class="song-artist">${song.artist}</div>
                        <div class="song-artist">🎯 ${song.difficulty} | 🎵 ${song.vocalRange}</div>
                    </div>
                `;
                songElement.onclick = () => selectSong(index);
                songList.appendChild(songElement);
            });
        }

        // Selecionar música
        function selectSong(index) {
            app.currentSong = songs[index];
            app.currentLyricIndex = 0;
            app.notesHit = 0;
            app.totalNotes = 0;
            app.noteHoldStart = null;
            
            // Atualizar interface
            document.querySelectorAll('.song-item').forEach((item, i) => {
                item.classList.toggle('active', i === index);
            });
            
            displayCurrentLyric();
            updateProgress();
            document.getElementById('startButton').disabled = !app.isMicActive;
            
            // Feedback ao usuário
            showFeedback(`🎵 "${app.currentSong.title}" selecionada! Prepare-se para cantar!`, 'info');
        }

        // Exibir letra atual
        function displayCurrentLyric() {
            if (!app.currentSong) return;
            
            const lyricsDisplay = document.getElementById('lyricsDisplay');
            let html = '';
            
            app.currentSong.lyrics.forEach((lyric, index) => {
                if (index === app.currentLyricIndex) {
                    html += `<div class="current-lyric">🎯 ${lyric.text} <span style="font-size: 14px;">(${lyric.note})</span></div>`;
                } else if (index < app.currentLyricIndex) {
                    html += `<div class="lyric-completed">✓ ${lyric.text}</div>`;
                } else {
                    html += `<div class="lyric-upcoming">${lyric.text}</div>`;
                }
            });
            
            lyricsDisplay.innerHTML = html;
            
            // Auto-scroll para a letra atual
            const currentLyricElement = lyricsDisplay.querySelector('.current-lyric');
            if (currentLyricElement) {
                currentLyricElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Atualizar progresso
        function updateProgress() {
            if (!app.currentSong) return;
            
            const progress = (app.currentLyricIndex / app.currentSong.lyrics.length) * 100;
            document.getElementById('progressFill').style.width = `${progress}%`;
            document.getElementById('songProgress').textContent = `${Math.round(progress)}% completo`;
        }

        // Mostrar feedback
        function showFeedback(message, type = 'info') {
            const feedbackBox = document.getElementById('feedbackBox');
            feedbackBox.textContent = message;
            feedbackBox.className = `feedback-box show feedback-${type}`;
            
            // Limpar timeout anterior
            if (app.feedbackTimeout) {
                clearTimeout(app.feedbackTimeout);
            }
            
            // Auto-esconder após 3 segundos
            app.feedbackTimeout = setTimeout(() => {
                feedbackBox.classList.remove('show');
            }, 3000);
        }

        // Alternar microfone
        async function toggleMicrophone() {
            if (app.isMicActive) {
                stopMicrophone();
            } else {
                await startMicrophone();
            }
        }

        // Iniciar microfone
        async function startMicrophone() {
            try {
                // Solicitar acesso ao microfone
                app.mediaStream = await navigator.mediaDevices.getUserMedia({ 
                    audio: {
                        echoCancellation: false,
                        noiseSuppression: false,
                        autoGainControl: false
                    } 
                });
                
                // Criar contexto de áudio
                app.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                app.analyser = app.audioContext.createAnalyser();
                app.analyser.fftSize = 4096;
                app.analyser.smoothingTimeConstant = 0.5;
                
                // Conectar microfone ao analisador
                app.microphone = app.audioContext.createMediaStreamSource(app.mediaStream);
                app.microphone.connect(app.analyser);
                
                app.isMicActive = true;
                document.getElementById('micButton').textContent = '🎤 Desativar Microfone';
                document.getElementById('connectionStatus').textContent = '🟢 Microfone Conectado';
                document.getElementById('connectionStatus').style.color = '#00B894';
                
                if (app.currentSong) {
                    document.getElementById('startButton').disabled = false;
                }
                
                // Iniciar detecção de pitch
                startPitchDetection();
                
                showFeedback('✅ Microfone ativado! Vamos começar!', 'success');
            } catch (error) {
                console.error('Erro ao acessar microfone:', error);
                showFeedback('❌ Erro ao acessar microfone. Verifique as permissões.', 'warning');
            }
        }

        // Parar microfone
        function stopMicrophone() {
            if (app.animationFrame) {
                cancelAnimationFrame(app.animationFrame);
                app.animationFrame = null;
            }
            
            if (app.microphone) {
                app.microphone.disconnect();
                app.microphone = null;
            }
            
            if (app.mediaStream) {
                app.mediaStream.getTracks().forEach(track => track.stop());
                app.mediaStream = null;
            }
            
            if (app.audioContext) {
                app.audioContext.close();
                app.audioContext = null;
            }
            
            app.isMicActive = false;
            document.getElementById('micButton').textContent = '🎤 Ativar Microfone';
            document.getElementById('connectionStatus').textContent = '🔴 Microfone Desconectado';
            document.getElementById('connectionStatus').style.color = '#FF6B6B';
            document.getElementById('startButton').disabled = true;
            
            // Resetar display
            document.getElementById('frequencyDisplay').textContent = '0 Hz';
            document.getElementById('noteDisplay').textContent = '--';
        }

        // Iniciar detecção de pitch
        function startPitchDetection() {
            if (!app.isMicActive) return;
            
            const bufferLength = app.analyser.fftSize;
            const buffer = new Float32Array(bufferLength);
            
            function detectPitchLoop() {
                if (!app.isMicActive) return;
                
                app.analyser.getFloatTimeDomainData(buffer);
                
                // Detectar pitch usando autocorrelação
                const frequency = autoCorrelate(buffer, app.audioContext.sampleRate);
                
                if (frequency > 50 && frequency < 2000) { // Faixa de voz humana
                    app.currentFrequency = frequency;
                    updatePitchDisplay(frequency);
                    
                    if (app.isPracticing) {
                        checkNoteAccuracy(frequency);
                    }
                }
                
                app.animationFrame = requestAnimationFrame(detectPitchLoop);
            }
            
            detectPitchLoop();
        }

        // Autocorrelação para detecção de pitch (versão corrigida)
        function autoCorrelate(buffer, sampleRate) {
            // Verificar se há sinal suficiente
            let rms = 0;
            for (let i = 0; i < buffer.length; i++) {
                rms += buffer[i] * buffer[i];
            }
            rms = Math.sqrt(rms / buffer.length);
            
            if (rms < 0.01) return -1; // Silêncio
            
            // Normalizar buffer
            let maxAbs = 0;
            for (let i = 0; i < buffer.length; i++) {
                const abs = Math.abs(buffer[i]);
                if (abs > maxAbs) maxAbs = abs;
            }
            
            // Autocorrelação
            const minSamples = Math.floor(sampleRate / 2000); // Frequência máxima: 2000 Hz
            const maxSamples = Math.floor(sampleRate / 50);   // Frequência mínima: 50 Hz
            let bestOffset = -1;
            let bestCorrelation = 0;
            
            for (let offset = minSamples; offset < maxSamples; offset++) {
                let correlation = 0;
                
                for (let i = 0; i < buffer.length - offset; i++) {
                    correlation += buffer[i] * buffer[i + offset];
                }
                
                correlation = correlation / (buffer.length - offset);
                
                if (correlation > bestCorrelation) {
                    bestCorrelation = correlation;
                    bestOffset = offset;
                }
            }
            
            if (bestOffset > 0 && bestCorrelation > 0.5) {
                const frequency = sampleRate / bestOffset;
                if (frequency > 50 && frequency < 2000) {
                    return frequency;
                }
            }
            
            return -1;
        }

        // Atualizar display de pitch
        function updatePitchDisplay(frequency) {
            document.getElementById('frequencyDisplay').textContent = Math.round(frequency) + ' Hz';
            
            const note = frequencyToNote(frequency);
            document.getElementById('noteDisplay').textContent = `Nota: ${note}`;
            
            // Atualizar posição da linha no indicador
            const pitchLine = document.getElementById('pitchLine');
            const pitchIndicator = document.getElementById('pitchIndicator');
            const minFreq = 100;
            const maxFreq = 1000;
            const position = ((frequency - minFreq) / (maxFreq - minFreq)) * 100;
            pitchLine.style.top = `${Math.max(0, Math.min(100, 100 - position))}%`;
        }

        // Converter frequência para nota musical
        function frequencyToNote(frequency) {
            const notes = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
            const A4 = 440;
            const C0 = A4 * Math.pow(2, -4.75);
            
            const halfSteps = Math.round(12 * Math.log2(frequency / C0));
            const octave = Math.floor(halfSteps / 12);
            const noteIndex = ((halfSteps % 12) + 12) % 12;
            
            return notes[noteIndex] + octave;
        }

        // Iniciar prática
        function startPractice() {
            if (!app.currentSong) {
                showFeedback('⚠️ Selecione uma música primeiro!', 'warning');
                return;
            }
            
            if (!app.isMicActive) {
                showFeedback('⚠️ Ative o microfone primeiro!', 'warning');
                return;
            }
            
            app.isPracticing = true;
            app.currentLyricIndex = 0;
            app.notesHit = 0;
            app.totalNotes = 0;
            app.noteHoldStart = null;
            app.sessionStart = new Date();
            
            document.getElementById('startButton').disabled = true;
            document.getElementById('startButton').textContent = '🎤 Cantando...';
            
            // Iniciar timer
            app.timerInterval = setInterval(updateTimer, 1000);
            
            // Definir primeira nota alvo
            setTargetNote();
            
            showFeedback('🎵 Comece a cantar! Siga a letra e mantenha o tom!', 'success');
        }

        // Parar prática
        function stopPractice() {
            if (!app.isPracticing) return;
            
            app.isPracticing = false;
            if (app.timerInterval) {
                clearInterval(app.timerInterval);
                app.timerInterval = null;
            }
            
            document.getElementById('startButton').disabled = !app.isMicActive;
            document.getElementById('startButton').textContent = '▶️ Iniciar Treino';
            
            const accuracy = app.totalNotes > 0 ? Math.round((app.notesHit / app.totalNotes) * 100) : 0;
            showFeedback(`🏁 Treino finalizado! Precisão: ${accuracy}%`, accuracy > 70 ? 'success' : 'warning');
            
            updateStats();
        }

        // Definir nota alvo
        function setTargetNote() {
            if (!app.currentSong || app.currentLyricIndex >= app.currentSong.lyrics.length) {
                finishSong();
                return;
            }
            
            const targetLyric = app.currentSong.lyrics[app.currentLyricIndex];
            app.targetFrequency = targetLyric.frequency;
            
            // Atualizar posição da nota alvo no indicador
            const targetNote = document.getElementById('targetNote');
            const minFreq = 100;
            const maxFreq = 1000;
            const position = ((app.targetFrequency - minFreq) / (maxFreq - minFreq)) * 100;
            targetNote.style.top = `${Math.max(0, Math.min(100, 100 - position))}%`;
            
            displayCurrentLyric();
            updateProgress();
            
            // Mostrar instrução
            showFeedback(`🎯 Cante a nota ${targetLyric.note} (${Math.round(targetLyric.frequency)} Hz)`, 'info');
        }

        // Verificar precisão da nota
        function checkNoteAccuracy(currentFreq) {
            if (!app.isPracticing || !app.currentSong) return;
            
            const targetFreq = app.targetFrequency;
            const cents = 1200 * Math.log2(currentFreq / targetFreq);
            
            // Verificar se está na nota alvo
            if (Math.abs(cents) <= app.tolerance) {
                // Nota está correta
                if (!app.noteHoldStart) {
                    app.noteHoldStart = Date.now();
                }
                
                const holdDuration = Date.now() - app.noteHoldStart;
                
                if (holdDuration >= app.requiredHoldDuration) {
                    // Nota atingida!
                    app.notesHit++;
                    app.totalNotes++;
                    
                    showFeedback(`🎯 Excelente! Nota ${frequencyToNote(targetFreq)} atingida!`, 'success');
                    
                    // Avançar para próxima nota
                    setTimeout(() => {
                        app.currentLyricIndex++;
                        app.noteHoldStart = null;
                        
                        if (app.currentLyricIndex < app.currentSong.lyrics.length) {
                            setTargetNote();
                        } else {
                            finishSong();
                        }
                    }, 300);
                } else {
                    // Mostrar progresso de segurar a nota
                    const progress = Math.round((holdDuration / app.requiredHoldDuration) * 100);
                    if (progress % 25 === 0) {
                        showFeedback(`🎵 Segure a nota... ${progress}%`, 'info');
                    }
                }
            } else {
                // Nota não está correta
                app.noteHoldStart = null;
                app.totalNotes++;
                
                const direction = cents > 0 ? 'desça' : 'suba';
                const centsAbs = Math.abs(cents);
                
                if (centsAbs <= app.tolerance * 2) {
                    showFeedback(`📈 Quase! ${direction} ${Math.round(centsAbs)} cents`, 'warning');
                } else {
                    const semitones = Math.round(centsAbs / 100);
                    showFeedback(`💪 ${direction} ${semitones} semitom(ns) para atingir ${frequencyToNote(targetFreq)}`, 'warning');
                }
            }
            
            updateStats();
        }

        // Finalizar música
        function finishSong() {
            app.isPracticing = false;
            if (app.timerInterval) {
                clearInterval(app.timerInterval);
                app.timerInterval = null;
            }
            
            const accuracy = app.totalNotes > 0 ? Math.round((app.notesHit / app.totalNotes) * 100) : 0;
            
            showFeedback(`🎉 Música completa! Precisão: ${accuracy}%`, accuracy > 70 ? 'success' : 'warning');
            
            document.getElementById('startButton').disabled = !app.isMicActive;
            document.getElementById('startButton').textContent = '▶️ Iniciar Treino';
            
            // Determinar tipo de voz baseado no desempenho
            determineVoiceType(accuracy);
            updateStats();
        }

        // Determinar tipo de voz
        function determineVoiceType(accuracy) {
            let voiceType = '';
            let description = '';
            
            if (accuracy > 85) {
                voiceType = "Soprano/Tenor";
                description = "Voz aguda com excelente controle";
            } else if (accuracy > 70) {
                voiceType = "Mezzo-Soprano/Barítono";
                description = "Voz média com bom controle";
            } else if (accuracy > 50) {
                voiceType = "Contralto/Baixo";
                description = "Voz grave com controle moderado";
            } else {
                voiceType = "Em desenvolvimento";
                description = "Continue praticando!";
            }
            
            app.voiceType = voiceType;
            
            const voiceTypeDisplay = document.getElementById('voiceTypeDisplay');
            voiceTypeDisplay.innerHTML = `
                <div class="voice-type-badge">
                    🎤 Tipo de voz: ${voiceType}
                    <br><small>${description}</small>
                </div>
            `;
        }

        // Atualizar timer
        function updateTimer() {
            if (!app.sessionStart) return;
            
            const now = new Date();
            const diff = Math.floor((now - app.sessionStart) / 1000);
            const minutes = Math.floor(diff / 60);
            const seconds = diff % 60;
            
            document.getElementById('sessionTimeStat').textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        }

        // Atualizar estatísticas
        function updateStats() {
            const accuracy = app.totalNotes > 0 ? Math.round((app.notesHit / app.totalNotes) * 100) : 0;
            document.getElementById('accuracyStat').textContent = `${accuracy}%`;
            document.getElementById('notesHitStat').textContent = app.notesHit;
        }

        // Atualizar status da conexão
        function updateConnectionStatus() {
            const status = document.getElementById('connectionStatus');
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                status.textContent = '🟡 Clique para ativar o microfone';
                status.style.color = '#FDCB6E';
            } else {
                status.textContent = '❌ Microfone não suportado';
                status.style.color = '#FF6B6B';
            }
        }

        // Inicializar aplicativo
        init();
    </script>
</body>
</html>
